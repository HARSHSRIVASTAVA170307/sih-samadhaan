# ── Main backend (Node/Express) ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Where the React dev server runs (used for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# ── AI Resume Match Analyzer (FastAPI) ──────────────────────────────────────
# URL of the resume-analyzer backend (see resume-analyzer/README.md)
RESUME_ANALYZER_URL=http://127.0.0.1:8001

# ── SkillRoute roadmap engine ───────────────────────────────────────────────
# The roadmap engine is imported directly from the SkillRoute repository
# (roadmap/backend). It only needs its Groq key here:
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model used by the SkillRoute agent.
# The repo hardcodes `llama-3.3-70b-versatile`, which Groq has retired; the
# bridge remaps it to a current model automatically. Set this only if the
# default override is also retired some day (list: GET api.groq.com/openai/v1/models)
# GROQ_MODEL=openai/gpt-oss-120b
